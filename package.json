{
  "name": "finanzas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "supabase:start": "npx supabase start >/dev/null && echo 'Supabase local iniciado.'",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset --local",
    "supabase:status": "npx supabase status",
    "supabase:env": "tsx scripts/sync-local-supabase-env.ts",
    "supabase:verify": "tsx scripts/verify-local-supabase.ts",
    "dev:local": "npm run supabase:start && npm run supabase:env && next dev",
    "worker": "tsx worker/main.ts",
    "worker:dry": "tsx worker/main.ts --dry-run",
    "worker:login": "tsx worker/login.ts",
    "worker:eval": "tsx worker/eval/run.ts",
    "worker:smoke": "tsx worker/local-db/smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "apexcharts": "^5.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^29.0.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
