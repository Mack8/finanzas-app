# Supabase local: `npm run supabase:env` crea NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY en .env.local.
# No copies aquí credenciales de proyectos remotos ni edites esas tres variables a mano.
# Para volver a una configuración remota, guardala fuera de Git como .env.remote.local.

# Integraciones externas opcionales. Déjalas vacías para desarrollo local.
BCCR_INDICATOR_EMAIL=your-registered-email@example.com
BCCR_INDICATOR_TOKEN=your-bccr-token

# Worker de ingesta de correo (worker/)
WORKER_USER_ID=
MS_CLIENT_ID=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
POLL_MINUTES=5
REQUIRE_AUTH_PASS=false
